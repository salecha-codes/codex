# No variables are required for the default deployment: existing shared room storage.
# Never put secrets in public/, source code, VERCEL_* client variables, or GitHub.

# Optional: independent database. Connect a Neon Postgres database in Vercel Storage,
# then set ROOM_STORAGE=postgres and DATABASE_URL to its private connection string.
# ROOM_STORAGE=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional: use a different trusted shared room API. Server-side only.
# ROOM_STORAGE=shared
# ROOM_BACKEND_URL=https://your-room-service.example
