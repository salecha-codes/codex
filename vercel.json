{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "functions": {"api/game.js": {"maxDuration": 15}},
  "rewrites": [
    {"source": "/game-api/:route*", "destination": "/api/game?route=:route*"},
    {"source": "/api/rooms", "destination": "/api/game?route=rooms"},
    {"source": "/api/rooms/:route*", "destination": "/api/game?route=rooms/:route*"},
    {"source": "/api/health", "destination": "/api/game?route=health"},
    {"source": "/c/:path*", "destination": "/index.html"}
  ],
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "same-origin"},
      {"key": "X-Frame-Options", "value": "DENY"}
    ]},
    {"source": "/", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
    {"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
    {"source": "/game-api/(.*)", "headers": [{"key": "Cache-Control", "value": "no-store"}]}
  ]
}
